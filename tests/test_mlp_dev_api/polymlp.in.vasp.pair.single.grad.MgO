n_type 2
elements Mg O

feature_type pair
cutoff 8.0
model_type 2
max_p 2

gaussian_params1 1.0 1.0 1
gaussian_params2 0.0 7.0 8

solver_alpha_params -3 1 5

atomic_energy -0.00040000 -1.85321219

train_data data-vasp-MgO/vaspruns/train1/vasprun-*.xml.polymlp
test_data data-vasp-MgO/vaspruns/test1/vasprun-*.xml.polymlp

solver_use_gradient True
solver_gtol 1e-5
use_auto_weight False
weight_force 0.8
weight_stress 1.0
